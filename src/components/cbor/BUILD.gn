source_set("cbor_headers") {
  visibility = [ ":*" ]
  sources = [
    "constants.h",
    "diagnostic_writer.h",
    "experiment_metrics.h",
    "reader.h",
    "values.h",
    "writer.h",
  ]

  public_deps = [
    ":buildflags",
    "//base",
  ]
}

source_set("cbor_rust_impl") {
  visibility = [ ":*" ]
  public = []
  sources = [
    "reader.cc",
    "writer.cc",
  ]

  defines = [ "CBOR_IMPLEMENTATION" ]

  deps = [
    ":buildflags",
    ":cbor_headers",
    "//base",
  ]

  if (!is_cronet_build) {
    deps += [
      "//build/rust/crubit",
      "//components/cbor/rust:cbor_rust_bindings",
    ]
  }
}

component("cbor") {
  sources = [
    "diagnostic_writer.cc",
    "values.cc",
  ]

  defines = [ "CBOR_IMPLEMENTATION" ]

  public_deps = [
    ":buildflags",
    ":cbor_headers",
    "//base",
  ]
  deps = [ ":cbor_rust_impl" ]
}
